# Public Supabase client. Set in Vercel; never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Webhook, role promotion, and billing writes.
SUPABASE_SERVICE_ROLE_KEY=

# Yearly $199 listing subscription. If STRIPE_SECRET_KEY is unset, checkout waives the fee for one year.
# STRIPE_LISTING_PRICE_ID is optional; without it Checkout uses price_data of 19900 USD per year.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LISTING_PRICE_ID=

# Front end Embedded Checkout (publishable, safe in the browser).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Owner notices (inquiry and review). If RESEND_API_KEY is unset, the server logs the email and does not send.
RESEND_API_KEY=
EMAIL_FROM=Furnished Keys <hello@furnishedkeys.com>
